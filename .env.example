# At least one model key is required. Groq is tried first, NVIDIA NIM is the fallback.

# Groq (free, no credit card): https://console.groq.com
GROQ_API_KEY=gsk_...

# NVIDIA NIM (free credits): https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-...
# meta/llama-3.3-70b-instruct was retired on 2026-08-26. Check /v1/models for what your account can call.
NVIDIA_MODEL=openai/gpt-oss-20b
# Per-provider timeout in ms (default 20000). NIM's free tier can be slow.
# MODEL_TIMEOUT_MS=25000   # per provider call
# MODEL_BUDGET_MS=55000    # whole request, across retries
# GROQ_MODEL=openai/gpt-oss-120b

# Seals interview sessions (AES-256-GCM). Required in production, min 32 chars.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
